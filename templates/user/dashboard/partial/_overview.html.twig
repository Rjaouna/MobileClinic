<section class="client-priority-card" id="user-dashboard-overview" aria-labelledby="user-next-appointment-title">
    {% set month_labels = {
        '01': 'janv', '02': 'févr', '03': 'mars', '04': 'avr',
        '05': 'mai', '06': 'juin', '07': 'juil', '08': 'août',
        '09': 'sept', '10': 'oct', '11': 'nov', '12': 'déc'
    } %}
    <header class="client-priority-card__header">
        <span class="client-priority-card__icon" aria-hidden="true">
            {% include 'components/_icon.html.twig' with { name: 'calendar', size: 20 } only %}
        </span>
        <h2 id="user-next-appointment-title">Prochain rendez-vous</h2>
        {% if next_appointment %}
            <span class="status-pill status-pill--{{ next_appointment.statusVariant }}">{{ next_appointment.statusLabel }}</span>
        {% endif %}
    </header>

    {% if next_appointment %}
        <div class="client-appointment-summary">
            <div class="client-appointment-summary__date" aria-label="{{ next_appointment.scheduledAt|date('d/m/Y à H:i') }}">
                <strong>{{ next_appointment.scheduledAt|date('d') }}</strong>
                <span>{{ month_labels[next_appointment.scheduledAt|date('m')] }}</span>
            </div>
            <div class="client-appointment-summary__content">
                <strong>{{ next_appointment.device }}</strong>
                <span>{{ next_appointment.problem }}</span>
                <p>
                    {% include 'components/_icon.html.twig' with { name: 'clock', size: 15 } only %}
                    <span>{{ next_appointment.scheduledAt|date('d/m/Y') }} à {{ next_appointment.scheduledAt|date('H:i') }}</span>
                </p>
            </div>
        </div>

        <div class="client-priority-card__actions">
            {% include 'components/_button.html.twig' with {
                label: 'Voir les détails',
                href: path('app_user_reservation_show', { id: next_appointment.id }),
                variant: 'primary',
                size: 'compact',
                icon: 'arrow-right'
            } only %}
        </div>
    {% else %}
        <div class="client-priority-empty">
            <span aria-hidden="true">{% include 'components/_icon.html.twig' with { name: 'calendar', size: 30 } only %}</span>
            <strong>Aucun rendez-vous à venir</strong>
            <p>Choisissez un créneau de réparation en quelques instants.</p>
            {% include 'components/_button.html.twig' with {
                label: 'Prendre rendez-vous',
                variant: 'primary',
                size: 'compact',
                icon: 'calendar',
                modal_target: 'appointment-modal'
            } only %}
        </div>
    {% endif %}
</section>
