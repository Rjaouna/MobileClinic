{% extends 'base.html.twig' %}

{% block title %}Mes rendez-vous - Mobile Clinic{% endblock %}
{% block meta_description %}Suivi des rendez-vous client Mobile Clinic.{% endblock %}

{% block body %}
    <main class="dashboard-page dashboard-page--user" data-user-live-refresh data-user-live-refresh-url="{{ path('app_api_user_live_refresh') }}" data-user-live-refresh-interval="10000" {% if open_modal|default(null) %}data-initial-modal="{{ open_modal }}"{% endif %}>
        <section class="dashboard-shell" aria-labelledby="reservation-title">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-kicker">Espace client</p>
                    <h1 id="reservation-title">Mes rendez-vous</h1>
                    <p>Retrouvez vos demandes, annulez un rendez-vous ou choisissez une autre date.</p>
                </div>

                {% include 'components/_dashboard_navigation.html.twig' with {
                    id: 'user-reservation-menu',
                    kicker: 'Espace client',
                    title: 'Menu rendez-vous',
                    subtitle: 'Sous-menus de vos rendez-vous.',
                    items: [
                        {
                            label: 'Prendre rendez-vous',
                            variant: 'primary',
                            icon: 'tool',
                            modal_target: 'appointment-modal',
                            description: 'Choisir un nouveau créneau.'
                        },
                        {
                            label: 'Mon espace',
                            href: path('app_user_dashboard'),
                            variant: 'secondary',
                            icon: 'home',
                            description: 'Retour au tableau de bord.'
                        },
                        {
                            label: 'Déconnexion',
                            href: path('app_logout'),
                            variant: 'secondary',
                            icon: 'logout',
                            description: 'Quitter votre espace.'
                        }
                    ]
                } only %}
            </header>

            {% for temporary_password in app.flashes('temporary_password') %}
                <section class="temporary-password-box" aria-labelledby="temporary-password-title">
                    <div>
                        <p class="dashboard-kicker">Compte créé</p>
                        <h2 id="temporary-password-title">Votre mot de passe temporaire</h2>
                        <p>Notez-le maintenant, puis changez-le depuis votre profil.</p>
                    </div>
                    <code>{{ temporary_password }}</code>
                    {% include 'components/_button.html.twig' with {
                        label: 'Changer mon mot de passe',
                        href: path('app_user_profile_index'),
                        variant: 'primary',
                        size: 'compact'
                    } only %}
                </section>
            {% endfor %}

            {% include 'components/_flash_messages.html.twig' %}

            {% include 'components/_loyalty_summary.html.twig' with {
                id: 'user-reservation-loyalty',
                title: 'Ma carte de fidélité',
                loyalty: loyalty,
                href: path('app_user_loyalty_index')
            } only %}

            {% include 'user/reservation/partial/_list.html.twig' with {
                appointments: appointments
            } only %}

            {% include 'user/reservation/partial/_modal_stack.html.twig' with {
                appointments: appointments,
                slot_days: slot_days
            } only %}

            {% include 'components/_appointment_modal.html.twig' with {
                id: 'appointment-modal',
                devices: devices,
                problems: problems,
                slot_days: slot_days,
                data: appointment_data|default({}),
                errors: appointment_errors|default([]),
                customer_email: app.user ? app.user.userIdentifier : '',
                customer_phone: app.user ? app.user.phone : '',
                is_connected_customer: app.user ? true : false,
                redirect_to: 'user_reservation'
            } only %}
        </section>
    </main>
{% endblock %}
