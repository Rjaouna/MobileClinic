{% extends 'base.html.twig' %}

{% block title %}Rendez-vous #{{ appointment.id }} - Mobile Clinic{% endblock %}
{% block meta_description %}Détail d’un rendez-vous Mobile Clinic.{% endblock %}

{% block body %}
    <main class="dashboard-page dashboard-page--user" data-user-live-refresh data-user-live-refresh-url="{{ path('app_api_user_live_refresh', { appointment_id: appointment.id }) }}" data-user-live-refresh-interval="10000" {% if open_modal|default(null) %}data-initial-modal="{{ open_modal }}"{% endif %}>
        <section class="dashboard-shell" aria-labelledby="reservation-show-title">
            <header class="dashboard-header">
                {% include 'user/reservation/partial/_show_heading.html.twig' with {
                    appointment: appointment
                } only %}

                {% set reservation_show_items = [] %}
                {% if appointment.canBeChangedByCustomer() %}
                    {% set reservation_show_items = reservation_show_items|merge([
                        {
                            label: 'Déplacer',
                            variant: 'primary',
                            icon: 'calendar',
                            modal_target: 'reservation-reschedule-modal',
                            description: 'Choisir une nouvelle date.'
                        },
                        {
                            label: 'Annuler',
                            variant: 'danger',
                            icon: 'x',
                            modal_target: 'reservation-cancel-modal',
                            description: 'Libérer ce créneau.'
                        }
                    ]) %}
                {% endif %}
                {% set reservation_show_items = reservation_show_items|merge([
                    {
                        label: 'Retour rendez-vous',
                        href: path('app_user_reservation_index'),
                        variant: appointment.canBeChangedByCustomer() ? 'secondary' : 'primary',
                        icon: 'calendar',
                        description: 'Revenir à vos rendez-vous.'
                    },
                    {
                        label: 'Mon espace',
                        href: path('app_user_dashboard'),
                        variant: 'secondary',
                        icon: 'home',
                        description: 'Retour au tableau de bord.'
                    },
                    {
                        label: 'Déconnexion',
                        href: path('app_logout'),
                        variant: 'secondary',
                        icon: 'logout',
                        description: 'Quitter votre espace.'
                    }
                ]) %}

                {% include 'components/_dashboard_navigation.html.twig' with {
                    id: 'user-reservation-show-menu',
                    kicker: 'Espace client',
                    title: 'Menu rendez-vous',
                    subtitle: 'Actions locales sur ce rendez-vous.',
                    items: reservation_show_items
                } only %}
            </header>

            {% include 'components/_flash_messages.html.twig' %}

            {% include 'components/_loyalty_summary.html.twig' with {
                id: 'user-reservation-show-loyalty',
                title: 'Ma carte de fidélité',
                loyalty: loyalty,
                href: path('app_user_loyalty_index')
            } only %}

            {% include 'user/reservation/partial/_show_detail.html.twig' with {
                appointment: appointment
            } only %}

            {% include 'user/reservation/partial/_show_modal_stack.html.twig' with {
                appointment: appointment,
                slot_days: slot_days
            } only %}
        </section>
    </main>
{% endblock %}
