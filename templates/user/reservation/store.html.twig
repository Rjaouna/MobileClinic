{% extends 'base.html.twig' %}

{% block title %}Mes réservations boutique - Mobile Clinic{% endblock %}
{% block meta_description %}Suivi des réservations boutique client Mobile Clinic.{% endblock %}

{% block body %}
    <main class="dashboard-page dashboard-page--user" data-user-live-refresh data-user-live-refresh-url="{{ path('app_api_user_live_refresh') }}" data-user-live-refresh-interval="10000">
        <section class="dashboard-shell" aria-labelledby="store-reservation-title">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-kicker">Espace client</p>
                    <h1 id="store-reservation-title">Réservations boutique</h1>
                    {% include 'user/partial/_account_line.html.twig' with {
                        id: 'user-store-account-line',
                        customer: customer
                    } only %}
                </div>

                {% include 'components/_dashboard_navigation.html.twig' with {
                    id: 'user-store-menu',
                    kicker: 'Espace client',
                    title: 'Menu boutique',
                    subtitle: 'Sous-menus de vos réservations boutique.',
                    items: [
                        {
                            label: 'Promotions',
                            href: path('app_public_product_index'),
                            variant: 'primary',
                            icon: 'bag',
                            description: 'Réserver un article en magasin.'
                        },
                        {
                            label: 'Mon espace',
                            href: path('app_user_dashboard'),
                            variant: 'secondary',
                            icon: 'home',
                            description: 'Retour au tableau de bord.'
                        },
                        {
                            label: 'Déconnexion',
                            href: path('app_logout'),
                            variant: 'secondary',
                            icon: 'logout',
                            description: 'Quitter votre espace.'
                        }
                    ]
                } only %}
            </header>

            {% include 'components/_flash_messages.html.twig' %}

            {% include 'components/_loyalty_summary.html.twig' with {
                id: 'user-store-loyalty',
                title: 'Ma carte de fidélité',
                loyalty: loyalty,
                href: path('app_user_loyalty_index')
            } only %}

            {% include 'user/reservation/partial/_store_list.html.twig' with {
                reservations: reservations,
                setting: setting
            } only %}
        </section>
    </main>
{% endblock %}
