<form class="modal-form" action="{{ path('app_user_profile_password_update') }}" method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('user_profile_password') }}">

    <div class="modal-form__grid">
        <div class="field-group field-group--wide">
            <label for="profile-password">Nouveau mot de passe</label>
            <input id="profile-password" type="password" name="password" autocomplete="new-password" minlength="8" data-modal-initial-focus required>
        </div>

        <div class="field-group field-group--wide">
            <label for="profile-password-confirmation">Confirmation</label>
            <input id="profile-password-confirmation" type="password" name="password_confirmation" autocomplete="new-password" minlength="8" required>
        </div>
    </div>

    <p class="modal-notice">
        Utilisez au moins 8 caractères. Le mot de passe temporaire ne sera plus affiché après changement.
    </p>

    {% include 'components/_button.html.twig' with {
        label: 'Enregistrer le mot de passe',
        variant: 'primary',
        type: 'submit',
        class: 'modal-form__submit'
    } only %}
</form>
