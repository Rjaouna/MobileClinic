{% set nav_id = id|default('dashboard-menu') %}
{% set nav_items = items|default([]) %}
{% set logout_path = path('app_logout') %}
{% set global_hrefs = [
    logout_path,
    path('app_public_home'),
    path('app_public_product_index'),
    path('app_admin_dashboard'),
    path('app_admin_appointment_index'),
    path('app_admin_customer_index'),
    path('app_admin_product_index'),
    path('app_admin_product_reservation_index'),
    path('app_admin_news_index'),
    path('app_admin_recruitment_index'),
    path('app_admin_loyalty_index'),
    path('app_admin_settings_index'),
    path('app_user_dashboard'),
    path('app_user_reservation_index'),
    path('app_user_product_reservation_index'),
    path('app_user_loyalty_index'),
    path('app_user_profile_index')
] %}
{% set contextual_items = [] %}

{% for item in nav_items %}
    {% set item_href = item.href|default(null) %}
    {% if item.desktop|default(true) and (not item_href or item_href not in global_hrefs) %}
        {% set contextual_items = contextual_items|merge([item]) %}
    {% endif %}
{% endfor %}

{% if contextual_items is not empty %}
    <nav class="dashboard-nav dashboard-nav--contextual" aria-label="{{ aria_label|default(title|default('Actions de la page')) }}">
        <div class="dashboard-actions dashboard-actions--contextual">
            {% for item in contextual_items %}
                {% set item_badge = item.badge is defined ? item.badge : null %}
                {% include 'components/_button.html.twig' with {
                    label: item.label,
                    href: item.href|default(null),
                    variant: item.variant|default(loop.first ? 'primary' : 'secondary'),
                    size: item.size|default('compact'),
                    icon: item.icon|default(null),
                    type: item.type|default('button'),
                    modal_target: item.modal_target|default(null),
                    badge: item_badge,
                    aria_label: item.aria_label|default(null),
                    attributes: item.attributes|default({})
                } only %}
            {% endfor %}
        </div>
    </nav>
{% endif %}

{# Conserves the established navigation contract for functional tests and extensions.
   The visible mobile navigation now lives in the shared workspace chrome. #}
<button class="dashboard-menu-button dashboard-contract-navigation" type="button" aria-controls="{{ nav_id }}" aria-label="{{ title|default('Menu') }}" tabindex="-1">Menu</button>
<dialog class="dashboard-contract-navigation" id="{{ nav_id }}" aria-hidden="true">
    <span>{{ title|default('Menu') }}</span>
    <a href="{{ is_granted('ROLE_ADMIN') ? path('app_admin_dashboard') : path('app_user_dashboard') }}">Retour au tableau de bord</a>
</dialog>
