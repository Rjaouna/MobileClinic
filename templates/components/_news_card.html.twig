{% set featured = featured|default(false) %}
{% set image_src = article.image ? article.imagePath : article.youtubeThumbnailUrl %}

<article class="news-card {{ featured ? 'news-card--featured' : '' }}">
    <a class="news-card__media" href="{{ path('app_public_news_show', { id: article.id }) }}" aria-label="Lire : {{ article.title }}">
        {% if image_src %}
            <img src="{{ image_src }}" alt="{{ article.image ? article.title : '' }}" loading="lazy">
        {% else %}
            <span class="news-card__placeholder">
                {% include 'components/_icon.html.twig' with { name: 'news', size: 34 } only %}
            </span>
        {% endif %}

        {% if article.video %}
            <span class="news-card__play" aria-hidden="true">
                {% include 'components/_icon.html.twig' with { name: 'play', size: 22 } only %}
            </span>
        {% endif %}
    </a>

    <div class="news-card__content">
        <div class="news-card__meta">
            <time datetime="{{ article.publishedAt|date('Y-m-d') }}">{{ article.publishedAt|date('d/m/Y') }}</time>
            <span>{{ article.mediaLabel }}</span>
        </div>
        <h3><a href="{{ path('app_public_news_show', { id: article.id }) }}">{{ article.title }}</a></h3>
        <p>{{ article.summary(featured ? 230 : 145) }}</p>
        <a class="news-card__link" href="{{ path('app_public_news_show', { id: article.id }) }}">
            Lire l’actualité
            <span aria-hidden="true">→</span>
        </a>
    </div>
</article>
