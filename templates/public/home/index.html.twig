{% extends 'base.html.twig' %}

{% block title %}Mobile Clinic - Réparation mobile sans attente{% endblock %}
{% block meta_description %}Réservez une réparation mobile, mettez un article de côté et retrouvez vos avantages fidélité avec Mobile Clinic.{% endblock %}

{% block body %}
    {% include 'components/_public_header.html.twig' with {
        active: 'repair',
        primary_action: 'appointment',
        setting: general_setting
    } only %}

    <main class="home-page" {% if open_modal|default(null) %}data-initial-modal="{{ open_modal }}"{% endif %}>
        <section class="hero hero--with-background hero--approved" aria-labelledby="home-hero-title" style="--hero-background-image: url('{{ home_hero_photo_path|e('html_attr') }}'); --hero-background-opacity: {{ home_hero_photo_opacity|default(100) }}%;">
            <div class="hero__inner">
                <div class="hero__content">
                    {% include 'components/_badge.html.twig' with {
                        label: 'Réparation - boutique - fidélité'
                    } only %}

                    <h1 id="home-hero-title" class="hero__title">
                        {{ home_hero_title }}
                        <span>{{ home_hero_highlight }}</span>
                    </h1>

                    <p class="hero__intro">{{ home_hero_description }}</p>

                    <div class="hero__actions">
                        {% include 'components/_button.html.twig' with {
                            label: 'Réserver une réparation',
                            variant: 'primary',
                            icon: 'arrow-right',
                            icon_position: 'end',
                            type: 'button',
                            modal_target: 'appointment-modal'
                        } only %}
                        {% include 'components/_button.html.twig' with {
                            label: 'Réserver un article',
                            href: path('app_public_product_index'),
                            variant: 'secondary',
                            icon: 'arrow-right',
                            icon_position: 'end'
                        } only %}
                    </div>

                    <div class="hero__features" id="avantages" aria-label="Avantages Mobile Clinic">
                        {% include 'components/_feature_item.html.twig' with { label: 'Sans paiement en ligne', icon: 'bolt' } only %}
                        {% include 'components/_feature_item.html.twig' with { label: 'Article gardé 24 h', icon: 'clock' } only %}
                        {% include 'components/_feature_item.html.twig' with { label: 'Avantages fidélité', icon: 'gift' } only %}
                    </div>
                </div>
            </div>
        </section>

        <section class="home-band home-band--services" id="services" aria-labelledby="services-title">
            <div class="home-band__inner">
                <div class="section-heading">
                    <p class="section-heading__kicker">Services</p>
                    <h2 id="services-title">Réparer, réserver, récupérer simplement.</h2>
                    <p>
                        Mobile Clinic rassemble les demandes rapides du quotidien : une réparation,
                        un article à garder de côté ou un avantage fidélité à retrouver.
                    </p>
                </div>

                <div class="service-grid">
                    {% for service in services %}
                        {% include 'components/_service_card.html.twig' with service only %}
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="home-band home-band--news" id="actualites" aria-labelledby="home-news-title">
            <div class="home-band__inner home-news">
                <div class="home-news__heading">
                    <div class="section-heading">
                        <p class="section-heading__kicker">Actualités</p>
                        <h2 id="home-news-title">Les nouvelles de l’atelier et de la boutique.</h2>
                        <p>Conseils, services et nouveautés : retrouvez l’essentiel de la vie Mobile Clinic.</p>
                    </div>
                    {% include 'components/_button.html.twig' with {
                        label: 'Toutes les actualités',
                        href: path('app_public_news_index'),
                        variant: 'secondary',
                        icon: 'news'
                    } only %}
                </div>

                <div class="news-grid news-grid--home">
                    {% for article in latest_news %}
                        {% include 'components/_news_card.html.twig' with {
                            article: article,
                            featured: loop.first
                        } only %}
                    {% else %}
                        <div class="news-empty-state">
                            {% include 'components/_icon.html.twig' with { name: 'news', size: 30 } only %}
                            <strong>Les premières actualités arrivent bientôt.</strong>
                            <p>Les nouveautés de l’atelier seront publiées ici.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="home-band home-band--promotions" id="promotions" aria-labelledby="home-promotions-title" style="--home-promotion-image: url('{{ home_promotion_photo_path|e('html_attr') }}');" data-promotion-parallax>
            <div class="home-band__inner home-promotions">
                <div class="home-promotions__heading">
                    <div>
                        <p class="section-heading__kicker">Promotions magasin</p>
                        <h2 id="home-promotions-title">Les dernières offres <span>à garder de côté.</span></h2>
                        <p>Réservez en ligne, utilisez votre cagnotte fidélité et récupérez vos articles directement en magasin.</p>
                        {% include 'components/_button.html.twig' with {
                            label: 'Voir toutes les promotions',
                            href: path('app_public_product_index'),
                            variant: 'primary',
                            icon: 'tag'
                        } only %}
                    </div>
                </div>

                <div class="product-grid home-promotions__grid">
                    {% for product in latest_products %}
                        {% include 'components/_product_card.html.twig' with {
                            product: product,
                            reserved_product_ids: reserved_product_ids,
                            cart_product_ids: []
                        } only %}
                    {% else %}
                        <div class="home-promotions__empty">
                            <strong>Les prochaines offres arrivent bientôt.</strong>
                            <span>Retrouvez ici les nouveautés ajoutées par la boutique.</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="home-band home-band--recruitment" id="recrutement" aria-labelledby="home-recruitment-title">
            <div class="home-band__inner home-recruitment">
                <div class="home-recruitment__content">
                    <p class="section-heading__kicker">Recrutement</p>
                    <h2 id="home-recruitment-title">Envie de rejoindre une équipe mobile care utile et proche des clients ?</h2>
                    <p>
                        Technicien réparation, conseiller boutique ou candidature spontanée :
                        envoyez votre profil en ligne et suivez un parcours simple.
                    </p>
                </div>

                <div class="home-recruitment__panel">
                    <span class="home-recruitment__icon" aria-hidden="true">
                        {% include 'components/_icon.html.twig' with { name: 'briefcase', size: 28 } only %}
                    </span>
                    <div>
                        <strong>Nous recrutons</strong>
                        <span>Atelier, boutique et relation client.</span>
                    </div>
                    {% include 'components/_button.html.twig' with {
                        label: 'Voir les postes',
                        href: path('app_public_recruitment_index'),
                        variant: 'primary',
                        icon: 'briefcase'
                    } only %}
                </div>
            </div>
        </section>

        {% include 'components/_appointment_modal.html.twig' with {
            id: 'appointment-modal',
            title: 'Réserver une réparation',
            subtitle: 'Un parcours court, avec uniquement les informations utiles.',
            action: path('app_public_appointment_create'),
            method: 'post',
            devices: devices,
            problems: problems,
            slot_days: slot_days,
            data: appointment_data|default({}),
            errors: appointment_errors|default([]),
            customer_email: app.user ? app.user.userIdentifier : '',
            customer_phone: app.user ? app.user.phone : '',
            is_connected_customer: app.user ? true : false,
            redirect_to: 'home'
        } only %}

        {% embed 'components/_modal.html.twig' with {
            id: 'login-modal',
            title: 'Votre espace Mobile Clinic',
            subtitle: 'Connectez-vous ou créez votre compte client en quelques instants.',
            class: 'modal--auth',
            is_open: open_modal|default(null) == 'login-modal'
        } %}
            {% block modal_body %}
                {% include 'components/_login_form.html.twig' with {
                    last_username: last_username|default(''),
                    login_error: login_error|default(null),
                    registration_data: registration_data|default({}),
                    registration_errors: registration_errors|default([]),
                    auth_panel: auth_panel|default('login')
                } only %}
            {% endblock %}
        {% endembed %}
    </main>

    {% include 'components/_public_footer.html.twig' with { setting: general_setting } only %}
{% endblock %}
