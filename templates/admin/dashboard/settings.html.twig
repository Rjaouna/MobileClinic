{% extends 'base.html.twig' %}

{% block title %}Paramètres généraux - Mobile Clinic{% endblock %}
{% block meta_description %}Paramètres administrateur Mobile Clinic pour la boutique, les rendez-vous et les délais.{% endblock %}

{% block body %}
    {% set legal = general_setting.legalProfile %}
    <main class="dashboard-page dashboard-page--admin">
        <section class="dashboard-shell" aria-labelledby="admin-settings-title">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-kicker">Administration</p>
                    <h1 id="admin-settings-title">Paramètres généraux</h1>
                    <p>Centralisez les délais boutique, les rappels automatiques et les jours visibles aux clients.</p>
                </div>

                {% include 'components/_dashboard_navigation.html.twig' with {
                    id: 'admin-settings-menu',
                    kicker: 'Administration',
                    title: 'Menu paramètres',
                    subtitle: 'Sous-menus de la rubrique paramètres.',
                    items: [
                        {
                            label: 'Ajouter une plage',
                            variant: 'primary',
                            icon: 'calendar',
                            modal_target: 'availability-add-modal',
                            description: 'Créer un créneau visible.'
                        },
                        {
                            label: 'Réglages boutique',
                            href: path('app_admin_settings_index') ~ '#store-settings-title',
                            variant: 'secondary',
                            icon: 'bag',
                            description: 'Délai de réservation et téléphone.'
                        },
                        {
                            label: 'Identité visuelle',
                            href: path('app_admin_settings_index') ~ '#site-logo-settings-title',
                            variant: 'secondary',
                            icon: 'image',
                            description: 'Logo affiché sur le site.'
                        },
                        {
                            label: 'Page d’accueil',
                            href: path('app_admin_settings_index') ~ '#homepage-settings-title',
                            variant: 'secondary',
                            icon: 'home',
                            description: 'Photo de fond accueil.'
                        },
                        {
                            label: 'Informations légales',
                            href: path('app_admin_settings_index') ~ '#legal-settings-title',
                            variant: 'secondary',
                            icon: 'shield',
                            description: 'Société, RGPD et réseaux sociaux.'
                        },
                        {
                            label: 'Rappels rendez-vous',
                            href: path('app_admin_settings_index') ~ '#appointment-settings-title',
                            variant: 'secondary',
                            icon: 'clock',
                            description: 'Règles des rappels administratifs.'
                        },
                        {
                            label: 'Jours et plages',
                            href: path('app_admin_settings_index') ~ '#availability-title',
                            variant: 'secondary',
                            icon: 'calendar',
                            description: 'Créneaux visibles aux clients.'
                        },
                        {
                            label: 'Dashboard',
                            href: path('app_admin_dashboard'),
                            variant: 'secondary',
                            icon: 'home',
                            description: 'Retour à la vue générale.'
                        },
                        {
                            label: 'Déconnexion',
                            href: path('app_logout'),
                            variant: 'secondary',
                            icon: 'logout',
                            description: 'Quitter la session admin.'
                        }
                    ]
                } only %}
            </header>

            {% include 'components/_flash_messages.html.twig' %}

            <section class="admin-panel" aria-labelledby="site-logo-settings-title">
                <div class="admin-panel__header">
                    <div>
                        <p class="dashboard-kicker">Identité visuelle</p>
                        <h2 id="site-logo-settings-title">Logo du site</h2>
                        <p>Choisissez le logo affiché dans l’en-tête et le pied de page du site public.</p>
                    </div>
                </div>

                <form class="settings-form" action="{{ path('app_admin_settings_logo_update') }}" method="post" enctype="multipart/form-data" data-site-logo-settings>
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_site_logo_settings') }}">

                    <div class="site-logo-settings">
                        <div class="site-logo-preview" data-site-logo-preview>
                            <img src="{{ general_setting.siteLogoPath|default('') }}" alt="Aperçu du logo Mobile Clinic" data-site-logo-preview-image {% if not general_setting.siteLogoPath %}hidden{% endif %}>
                            <div class="site-logo-preview__fallback" data-site-logo-preview-fallback {% if general_setting.siteLogoPath %}hidden{% endif %}>
                                <span class="brand__mark">S</span>
                                <span class="brand__text">
                                    <strong class="brand__name">Mobile Clinic</strong>
                                    <span class="brand__baseline">Mobile care</span>
                                </span>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="site-logo">Fichier du logo</label>
                            <input id="site-logo" type="file" name="site_logo" accept=".jpg,.jpeg,.png,image/jpeg,image/png" data-site-logo-input {% if not general_setting.siteLogoPath %}required{% endif %}>
                            <span class="field-help">PNG ou JPG, 4 Mo maximum. Pour un rendu optimal, utilisez un logo horizontal sur fond transparent.</span>
                            <span class="site-logo-current">
                                {% if general_setting.siteLogoPath %}
                                    Logo actuellement utilisé : <strong>{{ general_setting.siteLogoPath|split('/')|last }}</strong>
                                {% else %}
                                    Aucun fichier personnalisé : le logo Mobile Clinic par défaut est affiché.
                                {% endif %}
                            </span>
                        </div>
                    </div>

                    {% include 'components/_button.html.twig' with {
                        label: 'Enregistrer le logo',
                        variant: 'primary',
                        type: 'submit',
                        icon: 'image'
                    } only %}
                </form>
            </section>

            <section class="admin-panel" aria-labelledby="store-settings-title">
                <div class="admin-panel__header">
                    <div>
                        <p class="dashboard-kicker">Boutique</p>
                        <h2 id="store-settings-title">Délais des réservations</h2>
                        <p>Ce délai s’applique aux nouvelles réservations boutique tant qu’elles ne sont pas validées définitivement.</p>
                    </div>
                </div>

                <form class="settings-form" action="{{ path('app_admin_settings_store_update') }}" method="post" data-store-reservation-settings>
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_general_settings') }}">
                    <div class="settings-form__grid">
                        <div class="field-group">
                            <label for="store-phone">Numéro du magasin</label>
                            <input id="store-phone" type="tel" name="store_phone" value="{{ general_setting.storePhone }}" placeholder="03 20 50 71 03" required>
                            <span class="field-help">Affiché au client si le délai de retrait risque d’être dépassé.</span>
                        </div>
                        <div class="field-group">
                            <label for="hold-minutes">Durée de réservation boutique</label>
                            <input id="hold-minutes" type="number" name="product_reservation_hold_minutes" min="1" value="{{ general_setting.productReservationHoldMinutes }}" required>
                            <span class="field-help">En minutes. 1440 minutes correspondent à 1 journée.</span>
                        </div>
                        <div class="field-group">
                            <label for="reservation-alert-minutes">Alerte avant expiration</label>
                            <input id="reservation-alert-minutes" type="number" name="product_reservation_alert_minutes" min="1" max="{{ general_setting.productReservationHoldMinutes }}" value="{{ general_setting.productReservationAlertMinutes }}" required>
                            <span class="field-help">Le compteur passe en alerte à ce nombre de minutes de l’échéance. Par défaut : 120 minutes.</span>
                        </div>
                    </div>

                    {% include 'components/_button.html.twig' with {
                        label: 'Enregistrer la boutique',
                        variant: 'primary',
                        type: 'submit'
                    } only %}
                </form>
            </section>

            <section class="admin-panel" aria-labelledby="homepage-settings-title">
                <div class="admin-panel__header">
                    <div>
                        <p class="dashboard-kicker">Accueil</p>
                        <h2 id="homepage-settings-title">Premier bloc de l’accueil</h2>
                        <p>Modifiez les textes et la photo principale sans intervenir dans le code du site.</p>
                    </div>
                </div>

                <form class="settings-form" action="{{ path('app_admin_settings_homepage_update') }}" method="post" enctype="multipart/form-data" data-homepage-photo-settings>
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_homepage_settings') }}">

                    <div class="homepage-photo-settings">
                        <div class="homepage-photo-preview" data-homepage-photo-preview style="--homepage-photo-opacity: {{ general_setting.homeHeroPhotoOpacity }}%;">
                            <img src="{{ general_setting.homeHeroPhotoPath }}" alt="Aperçu de la photo d’accueil" data-homepage-photo-preview-image>
                            <div class="homepage-photo-preview__status">
                                <span>Aperçu du fond</span>
                                <strong data-homepage-photo-preview-value>{{ general_setting.homeHeroPhotoOpacity }} %</strong>
                            </div>
                        </div>

                        <div class="settings-form__grid">
                            <div class="field-group">
                                <label for="home-hero-title">Titre noir</label>
                                <input id="home-hero-title" type="text" name="home_hero_title" value="{{ general_setting.homeHeroTitle }}" maxlength="120" required>
                                <span class="field-help">Première ligne principale affichée en noir.</span>
                            </div>

                            <div class="field-group">
                                <label for="home-hero-highlight">Texte rouge</label>
                                <input id="home-hero-highlight" type="text" name="home_hero_highlight" value="{{ general_setting.homeHeroHighlight }}" maxlength="160" required>
                                <span class="field-help">Accroche mise en avant avec la couleur principale.</span>
                            </div>

                            <div class="field-group field-group--wide">
                                <label for="home-hero-description">Paragraphe</label>
                                <textarea id="home-hero-description" name="home_hero_description" rows="4" maxlength="400" required>{{ general_setting.homeHeroDescription }}</textarea>
                                <span class="field-help">Présentation courte affichée sous le titre.</span>
                            </div>

                            <div class="field-group field-group--wide">
                                <label for="home-hero-photo">Nouvelle image</label>
                                <input id="home-hero-photo" type="file" name="home_hero_photo" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
                                <span class="field-help">JPG, PNG ou WebP. Laissez ce champ vide pour conserver la photo actuelle.</span>
                            </div>

                            <div class="field-group field-group--wide homepage-opacity-control">
                                <div class="homepage-opacity-control__heading">
                                    <label for="home-hero-photo-opacity">Opacité de la photo</label>
                                    <output for="home-hero-photo-opacity" data-homepage-photo-opacity-value>{{ general_setting.homeHeroPhotoOpacity }} %</output>
                                </div>
                                <input id="home-hero-photo-opacity" type="range" name="home_hero_photo_opacity" min="0" max="100" step="5" value="{{ general_setting.homeHeroPhotoOpacity }}" data-homepage-photo-opacity>
                                <div class="homepage-opacity-control__scale" aria-hidden="true">
                                    <span>Fond transparent</span>
                                    <span>Photo très visible</span>
                                </div>
                                <span class="field-help">À 0 %, la photo disparaît. À 100 %, elle est affichée avec son intensité maximale derrière le contenu.</span>
                            </div>
                        </div>
                    </div>

                    {% include 'components/_button.html.twig' with {
                        label: 'Enregistrer le premier bloc',
                        variant: 'primary',
                        type: 'submit'
                    } only %}
                </form>
            </section>

            <section class="admin-panel" aria-labelledby="legal-settings-title">
                <div class="admin-panel__header">
                    <div>
                        <p class="dashboard-kicker">Site et conformité</p>
                        <h2 id="legal-settings-title">Informations légales et confidentialité</h2>
                        <p>Ces données alimentent automatiquement le footer, les mentions légales et la politique de confidentialité.</p>
                    </div>
                    <div class="settings-public-links">
                        {% include 'components/_button.html.twig' with {
                            label: 'Voir les mentions',
                            href: path('app_public_legal_notice'),
                            variant: 'secondary',
                            size: 'compact',
                            icon: 'info',
                            target: '_blank'
                        } only %}
                        {% include 'components/_button.html.twig' with {
                            label: 'Voir la confidentialité',
                            href: path('app_public_privacy'),
                            variant: 'secondary',
                            size: 'compact',
                            icon: 'shield',
                            target: '_blank'
                        } only %}
                        {% include 'components/_button.html.twig' with {
                            label: 'Voir la page Contact',
                            href: path('app_public_contact'),
                            variant: 'secondary',
                            size: 'compact',
                            icon: 'map-pin',
                            target: '_blank'
                        } only %}
                    </div>
                </div>

                <form class="settings-form settings-form--legal" action="{{ path('app_admin_settings_legal_update') }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_legal_settings') }}">

                    <fieldset class="settings-fieldset">
                        <legend>Entreprise</legend>
                        <div class="settings-form__grid">
                            <div class="field-group"><label for="legal-company-name">Dénomination exacte</label><input id="legal-company-name" name="legal[company_name]" value="{{ legal.company_name }}" required></div>
                            <div class="field-group"><label for="legal-trade-name">Nom commercial</label><input id="legal-trade-name" name="legal[trade_name]" value="{{ legal.trade_name }}"></div>
                            <div class="field-group"><label for="legal-form">Forme juridique</label><input id="legal-form" name="legal[legal_form]" value="{{ legal.legal_form }}" placeholder="SAS, SARL, EI..."></div>
                            <div class="field-group"><label for="legal-capital">Capital social</label><input id="legal-capital" name="legal[capital]" value="{{ legal.capital }}" placeholder="10 000 €"></div>
                            <div class="field-group field-group--wide"><label for="legal-office">Adresse du siège social</label><input id="legal-office" name="legal[registered_office]" value="{{ legal.registered_office }}"></div>
                            <div class="field-group field-group--wide"><label for="store-address">Adresse du magasin</label><input id="store-address" name="legal[store_address]" value="{{ legal.store_address }}" required></div>
                            <div class="field-group field-group--wide"><label for="google-business-url">Fiche Google Business</label><input id="google-business-url" type="url" name="legal[google_business_url]" value="{{ legal.google_business_url }}" placeholder="https://share.google/..."><span class="field-help">Ce lien alimente l’adresse et les boutons d’itinéraire du footer et de la page Contact.</span></div>
                            <div class="field-group"><label for="legal-siret">SIREN / SIRET</label><input id="legal-siret" name="legal[siret]" value="{{ legal.siret }}"></div>
                            <div class="field-group"><label for="legal-vat">TVA intracommunautaire</label><input id="legal-vat" name="legal[vat_number]" value="{{ legal.vat_number }}"></div>
                            <div class="field-group"><label for="legal-rcs">RCS et ville</label><input id="legal-rcs" name="legal[rcs]" value="{{ legal.rcs }}"></div>
                            <div class="field-group"><label for="legal-representative">Représentant légal</label><input id="legal-representative" name="legal[legal_representative]" value="{{ legal.legal_representative }}"></div>
                            <div class="field-group"><label for="legal-email">E-mail professionnel</label><input id="legal-email" type="email" name="legal[business_email]" value="{{ legal.business_email }}"></div>
                            <div class="field-group"><label for="legal-phone">Téléphone professionnel</label><input id="legal-phone" type="tel" name="legal[business_phone]" value="{{ legal.business_phone ?: general_setting.storePhone }}"></div>
                        </div>
                    </fieldset>

                    <fieldset class="settings-fieldset">
                        <legend>Horaires du magasin</legend>
                        <div class="settings-form__grid">
                            <div class="field-group"><label for="hours-monday">Lundi</label><input id="hours-monday" name="legal[opening_hours_monday]" value="{{ legal.opening_hours_monday }}" required></div>
                            <div class="field-group"><label for="hours-tuesday">Mardi</label><input id="hours-tuesday" name="legal[opening_hours_tuesday]" value="{{ legal.opening_hours_tuesday }}" required></div>
                            <div class="field-group"><label for="hours-wednesday">Mercredi</label><input id="hours-wednesday" name="legal[opening_hours_wednesday]" value="{{ legal.opening_hours_wednesday }}" required></div>
                            <div class="field-group"><label for="hours-thursday">Jeudi</label><input id="hours-thursday" name="legal[opening_hours_thursday]" value="{{ legal.opening_hours_thursday }}" required></div>
                            <div class="field-group"><label for="hours-friday">Vendredi</label><input id="hours-friday" name="legal[opening_hours_friday]" value="{{ legal.opening_hours_friday }}" required></div>
                            <div class="field-group"><label for="hours-saturday">Samedi</label><input id="hours-saturday" name="legal[opening_hours_saturday]" value="{{ legal.opening_hours_saturday }}" required></div>
                            <div class="field-group"><label for="hours-sunday">Dimanche</label><input id="hours-sunday" name="legal[opening_hours_sunday]" value="{{ legal.opening_hours_sunday }}" required></div>
                        </div>
                    </fieldset>

                    <fieldset class="settings-fieldset">
                        <legend>Site, publication et hébergeur</legend>
                        <div class="settings-form__grid">
                            <div class="field-group"><label for="legal-site-url">URL du site</label><input id="legal-site-url" type="url" name="legal[site_url]" value="{{ legal.site_url }}" placeholder="https://..."></div>
                            <div class="field-group"><label for="legal-domain">Nom de domaine</label><input id="legal-domain" name="legal[domain_name]" value="{{ legal.domain_name }}"></div>
                            <div class="field-group"><label for="legal-publication">Directeur de la publication</label><input id="legal-publication" name="legal[publication_director]" value="{{ legal.publication_director }}"></div>
                            <div class="field-group"><label for="legal-maintainer">Développement et maintenance</label><input id="legal-maintainer" name="legal[maintainer]" value="{{ legal.maintainer }}"></div>
                            <div class="field-group"><label for="legal-host-name">Nom de l’hébergeur</label><input id="legal-host-name" name="legal[host_name]" value="{{ legal.host_name }}"></div>
                            <div class="field-group"><label for="legal-host-phone">Téléphone de l’hébergeur</label><input id="legal-host-phone" type="tel" name="legal[host_phone]" value="{{ legal.host_phone }}"></div>
                            <div class="field-group field-group--wide"><label for="legal-host-address">Adresse de l’hébergeur</label><input id="legal-host-address" name="legal[host_address]" value="{{ legal.host_address }}"></div>
                        </div>
                    </fieldset>

                    <fieldset class="settings-fieldset">
                        <legend>RGPD et conservation</legend>
                        <div class="settings-form__grid">
                            <div class="field-group"><label for="legal-privacy-email">Contact pour les droits</label><input id="legal-privacy-email" type="email" name="legal[privacy_email]" value="{{ legal.privacy_email }}"></div>
                            <div class="field-group"><label for="legal-dpo">DPO ou référent RGPD</label><input id="legal-dpo" name="legal[dpo]" value="{{ legal.dpo }}"></div>
                            <div class="field-group"><label for="retention-customer">Comptes clients</label><input id="retention-customer" type="number" min="1" name="legal[customer_retention_months]" value="{{ legal.customer_retention_months }}"><span class="field-help">Durée maximale en mois.</span></div>
                            <div class="field-group"><label for="retention-appointment">Rendez-vous</label><input id="retention-appointment" type="number" min="1" name="legal[appointment_retention_months]" value="{{ legal.appointment_retention_months }}"><span class="field-help">Durée maximale en mois.</span></div>
                            <div class="field-group"><label for="retention-loyalty">Fidélité et réservations</label><input id="retention-loyalty" type="number" min="1" name="legal[loyalty_retention_months]" value="{{ legal.loyalty_retention_months }}"><span class="field-help">Durée maximale en mois.</span></div>
                            <div class="field-group"><label for="retention-recruitment">Candidatures non retenues</label><input id="retention-recruitment" type="number" min="1" name="legal[recruitment_retention_months]" value="{{ legal.recruitment_retention_months }}"><span class="field-help">Durée maximale en mois.</span></div>
                            <div class="field-group field-group--wide"><label for="legal-recipients">Destinataires des données</label><textarea id="legal-recipients" name="legal[data_recipients]" rows="3">{{ legal.data_recipients }}</textarea></div>
                            <div class="field-group field-group--wide"><label for="legal-processors">Sous-traitants et prestataires</label><textarea id="legal-processors" name="legal[processors]" rows="3" placeholder="Hébergeur, e-mail, sauvegarde...">{{ legal.processors }}</textarea></div>
                            <div class="field-group field-group--wide"><label for="legal-tools">Outils tiers utilisés</label><textarea id="legal-tools" name="legal[third_party_tools]" rows="3" placeholder="Analytics, paiement, CRM, carte, vidéo...">{{ legal.third_party_tools }}</textarea></div>
                            <label class="toggle-line"><input type="hidden" name="legal[outside_eu_transfer]" value="0"><input type="checkbox" name="legal[outside_eu_transfer]" value="1" {% if legal.outside_eu_transfer == '1' %}checked{% endif %}><span>Des données sont transférées hors de l’Union européenne</span></label>
                            <div class="field-group"><label for="outside-eu-details">Encadrement des transferts</label><textarea id="outside-eu-details" name="legal[outside_eu_details]" rows="3">{{ legal.outside_eu_details }}</textarea></div>
                        </div>
                    </fieldset>

                    <fieldset class="settings-fieldset">
                        <legend>Cookies et réseaux sociaux</legend>
                        <div class="settings-form__grid">
                            <div class="field-group field-group--wide"><label for="cookie-consent">Outil ou règle de consentement</label><textarea id="cookie-consent" name="legal[cookie_consent_tool]" rows="2">{{ legal.cookie_consent_tool }}</textarea></div>
                            <label class="toggle-line"><input type="hidden" name="legal[analytics_cookies]" value="0"><input type="checkbox" name="legal[analytics_cookies]" value="1" {% if legal.analytics_cookies == '1' %}checked{% endif %}><span>Cookies analytiques actifs</span></label>
                            <label class="toggle-line"><input type="hidden" name="legal[advertising_cookies]" value="0"><input type="checkbox" name="legal[advertising_cookies]" value="1" {% if legal.advertising_cookies == '1' %}checked{% endif %}><span>Cookies publicitaires actifs</span></label>
                            <div class="field-group"><label for="social-facebook">Facebook</label><input id="social-facebook" type="url" name="legal[facebook_url]" value="{{ legal.facebook_url }}" placeholder="https://facebook.com/..."></div>
                            <div class="field-group"><label for="social-instagram">Instagram</label><input id="social-instagram" type="url" name="legal[instagram_url]" value="{{ legal.instagram_url }}" placeholder="https://instagram.com/..."></div>
                            <div class="field-group"><label for="social-tiktok">TikTok</label><input id="social-tiktok" type="url" name="legal[tiktok_url]" value="{{ legal.tiktok_url }}" placeholder="https://tiktok.com/@..."></div>
                        </div>
                    </fieldset>

                    {% include 'components/_button.html.twig' with {
                        label: 'Enregistrer les informations légales',
                        variant: 'primary',
                        type: 'submit',
                        icon: 'shield'
                    } only %}
                </form>
            </section>

            <section class="admin-panel" aria-labelledby="appointment-settings-title">
                <div class="admin-panel__header">
                    <div>
                        <p class="dashboard-kicker">Rendez-vous</p>
                        <h2 id="appointment-settings-title">Rappels automatiques</h2>
                    </div>

                    <form action="{{ path('app_admin_appointment_sync_expired') }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_sync') }}">
                        <input type="hidden" name="_redirect_settings" value="1">
                        {% include 'components/_button.html.twig' with {
                            label: 'Créer les rappels maintenant',
                            variant: 'secondary',
                            size: 'compact',
                            type: 'submit'
                        } only %}
                    </form>
                </div>

                <form class="settings-form" action="{{ path('app_admin_appointment_settings_update') }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_settings') }}">
                    <input type="hidden" name="_redirect_settings" value="1">
                    <div class="settings-form__grid">
                        <div class="field-group">
                            <label for="first-reminder-delay">Premier rappel après</label>
                            <input id="first-reminder-delay" type="number" name="first_reminder_delay_minutes" min="1" value="{{ appointment_setting.firstReminderDelayMinutes }}">
                            <span class="field-help">Durée en minutes après l’heure prévue.</span>
                        </div>
                        <div class="field-group">
                            <label for="priority-reminder-delay">Alerte prioritaire après</label>
                            <input id="priority-reminder-delay" type="number" name="priority_reminder_delay_minutes" min="1" value="{{ appointment_setting.priorityReminderDelayMinutes }}">
                            <span class="field-help">Durée en minutes avant de renforcer l’alerte.</span>
                        </div>
                        <div class="field-group">
                            <label for="booking-window">Jours affichés au client</label>
                            <input id="booking-window" type="number" name="booking_window_days" min="1" value="{{ appointment_setting.bookingWindowDays }}">
                            <span class="field-help">Fenêtre visible dans le parcours de prise de rendez-vous.</span>
                        </div>
                        <div class="field-group">
                            <label for="default-duration">Durée par défaut d’un créneau</label>
                            <input id="default-duration" type="number" name="default_slot_duration_minutes" min="1" value="{{ appointment_setting.defaultSlotDurationMinutes }}">
                            <span class="field-help">Base utilisée quand vous créez une plage.</span>
                        </div>
                        <div class="field-group">
                            <label for="no-show-delay">Délai absence client</label>
                            <input id="no-show-delay" type="number" name="no_show_delay_minutes" min="1" value="{{ appointment_setting.noShowDelayMinutes }}">
                            <span class="field-help">Durée administrable avant décision sur un rendez-vous passé.</span>
                        </div>
                        <label class="toggle-line">
                            <input type="checkbox" name="reminders_enabled" value="1" {% if appointment_setting.remindersEnabled %}checked{% endif %}>
                            <span>Activer les rappels administratifs</span>
                        </label>
                    </div>

                    {% include 'components/_button.html.twig' with {
                        label: 'Enregistrer les rappels',
                        variant: 'primary',
                        type: 'submit'
                    } only %}
                </form>
            </section>

            <section class="admin-panel" aria-labelledby="availability-title">
                <div class="admin-panel__header">
                    <div>
                        <p class="dashboard-kicker">Créneaux visibles</p>
                        <h2 id="availability-title">Jours et plages horaires</h2>
                        <p>Entrez dans une journée pour activer, masquer ou supprimer ses plages horaires.</p>
                    </div>
                </div>

                {% if selected_day|default(null) %}
                    {% include 'admin/appointment/partial/_day.html.twig' with {
                        selected_day: selected_day,
                        selected_day_label: selected_day_label,
                        selected_day_summary: selected_day_summary,
                        selected_day_availabilities: selected_day_availabilities,
                        availability_ranges_by_day: availability_ranges_by_day,
                        days: days,
                        setting: appointment_setting,
                        settings_mode: true
                    } only %}
                {% endif %}

                <div class="week-day-grid">
                    {% for day in week_days %}
                        <article class="week-day-card {{ day.is_visible ? '' : 'week-day-card--muted' }} {{ selected_day|default(null) == day.day_of_week ? 'is-selected' : '' }}">
                            <div class="week-day-card__header">
                                <div>
                                    <span>Journée</span>
                                    <h3>{{ day.label }}</h3>
                                </div>

                                <span class="status-pill status-pill--{{ day.is_visible ? 'success' : 'neutral' }}">
                                    {{ day.is_visible ? 'Visible' : 'Masquée' }}
                                </span>
                            </div>

                            <p class="week-day-card__schedule">{{ day.schedule_label }}</p>

                            <div class="week-day-card__meta">
                                <span>{{ day.total_ranges }} plage{{ day.total_ranges > 1 ? 's' : '' }}</span>
                                <span>{{ day.enabled_ranges }} visible{{ day.enabled_ranges > 1 ? 's' : '' }}</span>
                            </div>

                            <div class="inline-actions">
                                {% include 'components/_button.html.twig' with {
                                    label: 'Entrer',
                                    href: path('app_admin_settings_day', { day: day.day_of_week }) ~ '#jour-' ~ day.day_of_week,
                                    variant: 'primary',
                                    size: 'compact'
                                } only %}

                                {% if day.total_ranges > 0 %}
                                    <form action="{{ path('app_admin_appointment_day_toggle', { day: day.day_of_week }) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_day_' ~ day.day_of_week) }}">
                                        <input type="hidden" name="_redirect_day" value="{{ day.day_of_week }}">
                                        <input type="hidden" name="_redirect_settings" value="1">
                                        {% include 'components/_button.html.twig' with {
                                            label: day.is_visible ? 'Cacher la journée' : 'Afficher la journée',
                                            variant: 'secondary',
                                            size: 'compact',
                                            type: 'submit'
                                        } only %}
                                    </form>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>

            {% embed 'components/_modal.html.twig' with {
                id: 'availability-add-modal',
                title: 'Ajouter une plage horaire',
                subtitle: 'Ce jour et cette plage seront affichés aux clients si vous les rendez visibles.'
            } %}
                {% block modal_body %}
                    {% include 'admin/appointment/modal/_add.html.twig' with {
                        days: days,
                        setting: appointment_setting,
                        settings_mode: true,
                        availability_ranges_by_day: availability_ranges_by_day
                    } only %}
                {% endblock %}
            {% endembed %}
        </section>
    </main>
{% endblock %}
