{% extends 'base.html.twig' %}

{% block title %}Dashboard admin - SymClinic{% endblock %}
{% block meta_description %}Tableau de bord administrateur SymClinic.{% endblock %}

{% block body %}
    <main class="dashboard-page dashboard-page--admin">
        <section class="dashboard-shell" aria-labelledby="admin-dashboard-title">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-kicker">Administration</p>
                    <h1 id="admin-dashboard-title">Dashboard admin</h1>
                    <p>Connecté avec {{ user_email }}.</p>
                </div>

                <div class="dashboard-actions">
                    {% include 'components/_button.html.twig' with {
                        label: 'Gérer les rendez-vous',
                        href: path('app_admin_appointment_index'),
                        variant: 'primary',
                        size: 'compact',
                        icon: 'calendar'
                    } only %}
                    {% include 'components/_button.html.twig' with {
                        label: 'Déconnexion',
                        href: path('app_logout'),
                        variant: 'secondary',
                        size: 'compact'
                    } only %}
                </div>
            </header>

            {% include 'components/_flash_messages.html.twig' %}

            <div class="dashboard-grid">
                <article class="dashboard-card">
                    <span>Réservations</span>
                    <strong>{{ stats.pending }}</strong>
                    <p>Demandes de réparation à valider.</p>
                </article>
                <article class="dashboard-card">
                    <span>À venir</span>
                    <strong>{{ stats.appointments }}</strong>
                    <p>Rendez-vous actifs dans le planning.</p>
                </article>
                <article class="dashboard-card">
                    <span>Pas présentés</span>
                    <strong>{{ stats.no_show }}</strong>
                    <p>Clients passés automatiquement en absence.</p>
                </article>
            </div>
        </section>
    </main>
{% endblock %}
