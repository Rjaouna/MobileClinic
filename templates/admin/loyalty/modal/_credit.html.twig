<form class="modal-form" action="{{ path('app_api_admin_loyalty_credit', { id: customer.id }) }}" method="post" data-ajax-form>
    <input type="hidden" name="_token" value="{{ csrf_token('admin_loyalty_credit_' ~ customer.id) }}">
    <div class="ajax-form-alert" data-ajax-errors hidden></div>

    <div class="modal-form__grid">
        <div class="field-group">
            <label for="loyalty-credit-amount">Montant crédité</label>
            <input id="loyalty-credit-amount" type="text" name="amount" placeholder="2 ou 2,50" inputmode="decimal" data-modal-initial-focus required>
        </div>
        <div class="field-group field-group--wide">
            <label for="loyalty-credit-reason">Motif obligatoire</label>
            <textarea id="loyalty-credit-reason" name="reason" rows="3" required></textarea>
        </div>
    </div>

    {% include 'components/_button.html.twig' with {
        label: 'Ajouter le crédit',
        variant: 'primary',
        type: 'submit',
        class: 'modal-form__submit'
    } only %}
</form>
