<div id="news-stats-region" class="dashboard-grid dashboard-grid--four">
    <article class="dashboard-card">
        <span>Actualités</span>
        <strong>{{ stats.total }}</strong>
        <p>Publications enregistrées.</p>
    </article>
    <article class="dashboard-card">
        <span>En ligne</span>
        <strong>{{ stats.published }}</strong>
        <p>Actualités visibles par les visiteurs.</p>
    </article>
    <article class="dashboard-card">
        <span>À renouveler</span>
        <strong>{{ stats.expired }}</strong>
        <p>Actualités arrivées à échéance.</p>
    </article>
    <article class="dashboard-card">
        <span>Vidéos</span>
        <strong>{{ stats.videos }}</strong>
        <p>Publications reliées à YouTube.</p>
    </article>
</div>
