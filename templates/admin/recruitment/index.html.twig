{% extends 'base.html.twig' %}

{% block title %}Recrutement admin - Mobile Clinic{% endblock %}
{% block meta_description %}Gestion administrateur des candidatures Mobile Clinic.{% endblock %}

{% block body %}
    <main class="dashboard-page dashboard-page--admin">
        <section class="dashboard-shell" aria-labelledby="admin-recruitment-title">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-kicker">Administration</p>
                    <h1 id="admin-recruitment-title">Recrutement</h1>
                    <p>Suivez les candidatures, les profils à contacter et les décisions prises par l’équipe.</p>
                </div>

                {% include 'components/_dashboard_navigation.html.twig' with {
                    id: 'admin-recruitment-menu',
                    kicker: 'Administration',
                    title: 'Menu recrutement',
                    subtitle: 'Sous-menus de la rubrique recrutement.',
                    items: [
                        {
                            label: 'Nouveau poste',
                            variant: 'primary',
                            icon: 'briefcase',
                            modal_target: 'recruitment-position-add',
                            description: 'Publier une nouvelle opportunité.'
                        },
                        {
                            label: 'Candidatures',
                            href: path('app_admin_recruitment_index') ~ '#recruitment-list-title',
                            variant: 'secondary',
                            icon: 'user',
                            description: 'Traiter les demandes reçues.'
                        },
                        {
                            label: 'Voir la page recrutement',
                            href: path('app_public_recruitment_index'),
                            variant: 'secondary',
                            icon: 'briefcase',
                            description: 'Ouvrir la page publique.'
                        },
                        {
                            label: 'Dashboard',
                            href: path('app_admin_dashboard'),
                            variant: 'secondary',
                            icon: 'home',
                            description: 'Retour à la vue générale.'
                        },
                        {
                            label: 'Déconnexion',
                            href: path('app_logout'),
                            variant: 'secondary',
                            icon: 'logout',
                            description: 'Quitter la session admin.'
                        }
                    ]
                } only %}
            </header>

            {% include 'components/_flash_messages.html.twig' %}
            <div class="ajax-toast" data-ajax-toast hidden></div>

            <div class="dashboard-grid dashboard-grid--four">
                <article class="dashboard-card">
                    <span>Postes publiés</span>
                    <strong>{{ stats.active_positions }}</strong>
                    <p>Opportunités visibles.</p>
                </article>
                <article class="dashboard-card">
                    <span>Candidatures</span>
                    <strong>{{ stats.total }}</strong>
                    <p>Total enregistré.</p>
                </article>
                <article class="dashboard-card">
                    <span>À suivre</span>
                    <strong>{{ stats.open }}</strong>
                    <p>Profils encore ouverts.</p>
                </article>
                <article class="dashboard-card">
                    <span>Vue active</span>
                    <strong>{{ stats.visible }}</strong>
                    <p>Résultat selon les filtres.</p>
                </article>
            </div>

            {% embed 'components/_data_table_shell.html.twig' with {
                id: 'recruitment-positions-title',
                kicker: 'Opportunités',
                title: 'Postes proposés',
                subtitle: 'Catégorie, contenu, compétences et visibilité sur la page publique.',
                count_label: positions|length ~ ' poste' ~ (positions|length > 1 ? 's' : ''),
                icon: 'briefcase'
            } %}
                {% block table_actions %}
                    {% include 'components/_button.html.twig' with {
                        label: 'Nouveau poste',
                        variant: 'primary',
                        size: 'compact',
                        icon: 'briefcase',
                        type: 'button',
                        modal_target: 'recruitment-position-add'
                    } only %}
                {% endblock %}

                {% block table_content %}
                    {% include 'admin/recruitment/partial/_position_table.html.twig' with {
                        positions: positions
                    } only %}
                {% endblock %}
            {% endembed %}

            {% embed 'components/_data_table_shell.html.twig' with {
                id: 'recruitment-list-title',
                kicker: 'Candidatures',
                title: 'Liste recrutement',
                subtitle: 'Recherche, tri, filtre statut et traitement rapide des profils.',
                count_label: applications|length ~ ' candidature' ~ (applications|length > 1 ? 's' : ''),
                icon: 'briefcase'
            } %}
                {% block table_actions %}
                    <form class="filter-form filter-form--wide filter-form--instant data-table-filter" method="get" action="{{ path('app_admin_recruitment_index') }}" data-instant-filter>
                        <label for="recruitment-search">Recherche</label>
                        <input id="recruitment-search" type="search" name="q" value="{{ search }}" placeholder="Candidat, téléphone, e-mail ou poste" autocomplete="off">
                        <label for="recruitment-status-filter">Statut</label>
                        <select id="recruitment-status-filter" name="status">
                            <option value="">Tous les statuts</option>
                            {% for value, label in status_labels %}
                                <option value="{{ value }}" {% if status == value %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </form>
                {% endblock %}

                {% block table_content %}
                    {% include 'admin/recruitment/partial/_table.html.twig' with {
                        applications: applications
                    } only %}
                {% endblock %}
            {% endembed %}

            {% include 'admin/recruitment/partial/_modal_stack.html.twig' with {
                applications: applications,
                positions: positions,
                position_categories: position_categories,
                status_labels: status_labels,
                search: search,
                status: status
            } only %}
        </section>
    </main>
{% endblock %}
