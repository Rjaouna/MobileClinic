{% extends 'base.html.twig' %}

{% block title %}Promotions admin - Mobile Clinic{% endblock %}
{% block meta_description %}Gestion administrateur des promotions et réservations boutique Mobile Clinic.{% endblock %}

{% block body %}
    <main class="dashboard-page dashboard-page--admin" data-admin-store-live-refresh data-admin-store-live-refresh-url="{{ path('app_api_admin_product_reservation_refresh') }}" data-admin-store-live-refresh-interval="10000">
        <section class="dashboard-shell" aria-labelledby="admin-product-title">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-kicker">Administration</p>
                    <h1 id="admin-product-title">Promotions</h1>
                    <p>Ajoutez des articles, gérez les infos personnalisées et suivez les réservations magasin.</p>
                </div>

                {% include 'components/_dashboard_navigation.html.twig' with {
                    id: 'admin-product-menu',
                    kicker: 'Administration',
                    title: 'Menu promotions',
                    subtitle: 'Sous-menus de la rubrique promotions.',
                    items: [
                        {
                            label: 'Ajouter un article',
                            variant: 'primary',
                            icon: 'bag',
                            modal_target: 'product-add-modal',
                            description: 'Créer une promotion boutique.'
                        },
                        {
                            label: 'Réservations boutique',
                            href: path('app_admin_product_index') ~ '#product-reservation-title',
                            variant: 'secondary',
                            icon: 'briefcase',
                            description: 'Articles gardés en magasin.'
                        },
                        {
                            label: 'Articles vendus',
                            href: path('app_admin_product_index', { filter: 'sold' }) ~ '#product-filter-title',
                            variant: 'secondary',
                            icon: 'tag',
                            description: 'Voir les promotions retirées.'
                        },
                        {
                            label: 'Dashboard',
                            href: path('app_admin_dashboard'),
                            variant: 'secondary',
                            icon: 'home',
                            description: 'Retour à la vue générale.'
                        },
                        {
                            label: 'Déconnexion',
                            href: path('app_logout'),
                            variant: 'secondary',
                            icon: 'logout',
                            description: 'Quitter la session admin.'
                        }
                    ]
                } only %}
            </header>

            {% include 'components/_flash_messages.html.twig' %}

            {% embed 'components/_data_table_shell.html.twig' with {
                id: 'product-filter-title',
                kicker: 'Catalogue',
                title: 'Articles promotionnels',
                subtitle: 'Photos, prix, infos personnalisées et état de disponibilité.',
                count_label: products|length ~ ' article' ~ (products|length > 1 ? 's' : ''),
                icon: 'bag'
            } %}
                {% block table_actions %}
                    <form class="filter-form filter-form--wide filter-form--instant data-table-filter" method="get" action="{{ path('app_admin_product_index') }}" data-instant-filter>
                        <label for="product-search">Recherche</label>
                        <input id="product-search" type="search" name="q" value="{{ search }}" placeholder="Nom ou description" autocomplete="off">
                        <label for="product-filter">État</label>
                        <select id="product-filter" name="filter">
                            <option value="">Tous les articles</option>
                            <option value="active" {% if filter == 'active' %}selected{% endif %}>Articles visibles</option>
                            <option value="inactive" {% if filter == 'inactive' %}selected{% endif %}>Articles masqués</option>
                            <option value="sold" {% if filter == 'sold' %}selected{% endif %}>Articles vendus</option>
                        </select>
                    </form>
                {% endblock %}

                {% block table_content %}
                    {% include 'admin/product/partial/_table.html.twig' with {
                        products: products,
                        reserved_product_ids: reserved_product_ids
                    } only %}
                {% endblock %}
            {% endembed %}

            {% embed 'components/_data_table_shell.html.twig' with {
                id: 'product-reservation-title',
                kicker: 'Réservations boutique',
                title: 'Articles gardés en magasin',
                subtitle: 'Une validation définitive empêche l’annulation automatique par délai.',
                count_label: reservations|length ~ ' réservation' ~ (reservations|length > 1 ? 's' : ''),
                icon: 'briefcase'
            } %}
                {% block table_actions %}
                    <form class="filter-form filter-form--wide filter-form--instant data-table-filter" method="get" action="{{ path('app_admin_product_index') }}" data-instant-filter>
                        <label for="reservation-search">Recherche</label>
                        <input id="reservation-search" type="search" name="reservation_search" placeholder="Client, téléphone ou article" autocomplete="off">
                        <label for="reservation-status-filter">Statut</label>
                        <select id="reservation-status-filter" name="reservation_status">
                            <option value="">Tous les statuts</option>
                            {% for value, label in reservation_status_labels %}
                                <option value="{{ value }}" {% if reservation_status == value %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                        <label for="reservation-urgency-filter">Échéance</label>
                        <select id="reservation-urgency-filter" name="reservation_urgency">
                            <option value="">Tous les délais</option>
                            <option value="comfortable">Délai confortable</option>
                            <option value="soon">Clients à appeler</option>
                            <option value="critical">Urgent</option>
                            <option value="expired">Expiré</option>
                        </select>
                    </form>
                {% endblock %}

                {% block table_content %}
                    {% include 'admin/product/partial/_reservation_table.html.twig' with {
                        reservations: reservations,
                        setting: setting
                    } only %}
                {% endblock %}
            {% endembed %}

            {% include 'admin/product/partial/_modal_stack.html.twig' with {
                products: products,
                reserved_product_ids: reserved_product_ids
            } only %}
        </section>
    </main>
{% endblock %}
