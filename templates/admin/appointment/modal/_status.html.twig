<form class="modal-form admin-status-form" action="{{ path('app_api_admin_appointment_status_update', { id: appointment.id }) }}" method="post" data-ajax-form data-admin-status-form>
    <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_status_' ~ appointment.id) }}">
    <input type="hidden" name="_list_status" value="{{ status|default('') }}">
    <input type="hidden" name="_list_search" value="{{ search|default('') }}">
    <div class="ajax-form-alert" data-ajax-errors hidden></div>

    <div class="status-review">
        <div>
            <span>Ancien statut</span>
            <strong>{{ appointment.statusLabel }}</strong>
        </div>
        <div>
            <span>Date du rendez-vous</span>
            <strong>{{ appointment.scheduledAt|date('d/m/Y H:i') }}</strong>
        </div>
        <div>
            <span>Client</span>
            <strong>{{ appointment.customer ? appointment.customer.displayName : appointment.email }}</strong>
        </div>
        <div>
            <span>Téléphone</span>
            <strong>{{ appointment.phone ?: 'Non renseigné' }}</strong>
        </div>
    </div>

    <div class="modal-form__grid">
        <div class="field-group">
            <label for="appointment-status-{{ appointment.id }}-status">Nouveau statut</label>
            <select id="appointment-status-{{ appointment.id }}-status" name="status" data-admin-status-select data-modal-initial-focus required>
                {% for value, label in admin_status_choices %}
                    <option value="{{ value }}" data-consequence="{{ status_consequences[value]|default('') }}" {% if appointment.status == value %}selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="field-group">
            <label for="appointment-status-{{ appointment.id }}-duration">Durée du rendez-vous</label>
            <input id="appointment-status-{{ appointment.id }}-duration" type="number" name="duration_minutes" min="1" value="{{ appointment.durationMinutes }}">
        </div>

        <div class="field-group field-group--wide admin-reschedule-fields" data-admin-reschedule-fields>
            <label for="appointment-status-{{ appointment.id }}-scheduled">Date du rendez-vous</label>
            <input id="appointment-status-{{ appointment.id }}-scheduled" type="datetime-local" name="scheduled_at" value="{{ appointment.scheduledAt|date('Y-m-d\\TH:i') }}">
            <span class="field-help">Modifiez la date si besoin. Pour un rendez-vous actif, le créneau doit être dans le futur et libre.</span>
        </div>

        <div class="field-group field-group--wide">
            <label for="appointment-status-{{ appointment.id }}-note">Note admin</label>
            <textarea id="appointment-status-{{ appointment.id }}-note" name="admin_note" placeholder="Note interne utile pour l’équipe">{{ appointment.adminNote }}</textarea>
        </div>
    </div>

    <div class="status-consequence" data-admin-status-consequence>
        {{ status_consequences[appointment.status]|default('Sélectionnez un statut pour afficher la conséquence.') }}
    </div>

    <label class="toggle-line">
        <input type="checkbox" name="confirm_status" value="1" required>
        <span>Je confirme cette décision et sa conséquence sur la fidélité.</span>
    </label>

    {% include 'components/_button.html.twig' with {
        label: 'Confirmer la mise à jour',
        variant: 'primary',
        type: 'submit',
        class: 'modal-form__submit'
    } only %}
</form>
