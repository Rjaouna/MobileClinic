<div class="table-wrapper data-table-wrapper">
    <table class="data-table data-table--professional">
        <thead>
            <tr>
                <th>Client</th>
                <th>Demande</th>
                <th>Créneau</th>
                <th>Statut</th>
                <th>Action admin</th>
            </tr>
        </thead>
        <tbody id="appointment-table-body">
            {% include 'admin/appointment/partial/_table_body.html.twig' with {
                appointments: appointments,
                status_labels: status_labels,
                admin_status_choices: admin_status_choices|default(status_labels),
                status: status|default('')
            } only %}
        </tbody>
    </table>
</div>
