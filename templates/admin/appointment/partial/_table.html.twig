<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Client</th>
                <th>Demande</th>
                <th>Créneau</th>
                <th>Statut</th>
                <th>Action admin</th>
            </tr>
        </thead>
        <tbody>
            {% for appointment in appointments %}
                <tr>
                    <td>
                        <strong>{{ appointment.email }}</strong>
                        <span>{{ appointment.phone ?: 'Téléphone non renseigné' }}</span>
                    </td>
                    <td>
                        <strong>{{ appointment.device|capitalize }}</strong>
                        <span>{{ appointment.problem|replace({'_': ' '})|capitalize }}</span>
                    </td>
                    <td>
                        <strong>{{ appointment.scheduledAt|date('d/m/Y') }}</strong>
                        <span>{{ appointment.scheduledAt|date('H:i') }} - {{ appointment.endsAt|date('H:i') }}</span>
                    </td>
                    <td>
                        <span class="status-pill status-pill--{{ appointment.statusVariant }}">{{ appointment.statusLabel }}</span>
                    </td>
                    <td>
                        <form class="table-action-form" action="{{ path('app_admin_appointment_status_update', { id: appointment.id }) }}" method="post">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_status_' ~ appointment.id) }}">
                            <select name="status" aria-label="Changer le statut">
                                {% for value, label in status_labels %}
                                    <option value="{{ value }}" {% if appointment.status == value %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                            <input type="text" name="admin_note" value="{{ appointment.adminNote }}" placeholder="Note admin">
                            {% include 'components/_button.html.twig' with {
                                label: 'Mettre à jour',
                                variant: 'primary',
                                size: 'compact',
                                type: 'submit'
                            } only %}
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">
                        <p class="empty-state">Aucun rendez-vous ne correspond à ce filtre.</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
