<section id="admin-notification-center" class="admin-notification-center" aria-labelledby="admin-notification-title" {% if reminder_view.total <= 0 %}hidden{% endif %}>
    <div class="admin-panel__header">
        <div>
            <p class="dashboard-kicker">Centre de notifications</p>
            <h2 id="admin-notification-title">Rappels rendez-vous</h2>
            <p>
                {% if reminder_view.total > 0 %}
                    {{ reminder_view.total }} rendez-vous {{ reminder_view.total > 1 ? 'passés sont encore en attente' : 'passé est encore en attente' }} de décision admin : confirmez la présence, l’absence, l’annulation ou reportez le créneau.
                {% else %}
                    Les rappels apparaissent ici quand un rendez-vous est passé et reste en attente de décision admin.
                {% endif %}
            </p>
        </div>

        <span class="notification-counter {{ reminder_view.total > 0 ? 'is-active' : '' }}">{{ reminder_view.total }}</span>
    </div>

    {% if reminder_view.items is empty %}
        <p class="empty-state">Aucun rappel actif. Les prochains rendez-vous passés apparaîtront ici.</p>
    {% else %}
        <div class="notification-list">
            {% for item in reminder_view.items %}
                {% set appointment = item.appointment %}
                <article class="notification-card notification-card--{{ item.level_variant }}" data-notification-key="{{ item.toast_key }}">
                    <div class="notification-card__main">
                        <span class="notification-card__level">{{ item.type_label }}</span>
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.message }}</p>
                        <div class="notification-card__meta">
                            <span>{{ item.customer_name }}</span>
                            <span>{{ item.phone }}</span>
                            <span>{{ appointment.device }} · {{ appointment.problem }}</span>
                            <span>{{ item.scheduled_label }}</span>
                        </div>
                    </div>

                    <div class="notification-card__actions">
                        {% if item.quick_status %}
                            <form class="inline-form" action="{{ path('app_api_admin_appointment_status_update', { id: appointment.id }) }}" method="post" data-ajax-form>
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_status_' ~ appointment.id) }}">
                                <input type="hidden" name="status" value="{{ item.quick_status }}">
                                <input type="hidden" name="confirm_status" value="1">
                                <input type="hidden" name="admin_note" value="Présence confirmée depuis le rappel admin.">
                                <input type="hidden" name="_list_status" value="{{ status|default('') }}">
                                <input type="hidden" name="_list_search" value="{{ search|default('') }}">
                                {% include 'components/_button.html.twig' with {
                                    label: 'Client arrivé',
                                    variant: 'secondary',
                                    size: 'compact',
                                    type: 'submit'
                                } only %}
                            </form>
                        {% endif %}

                        <form class="inline-form" action="{{ path('app_api_admin_appointment_status_update', { id: appointment.id }) }}" method="post" data-ajax-form>
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_appointment_status_' ~ appointment.id) }}">
                            <input type="hidden" name="status" value="{{ constant('App\\Entity\\Appointment::STATUS_NO_SHOW') }}">
                            <input type="hidden" name="confirm_status" value="1">
                            <input type="hidden" name="admin_note" value="Client absent depuis le rappel admin.">
                            <input type="hidden" name="_list_status" value="{{ status|default('') }}">
                            <input type="hidden" name="_list_search" value="{{ search|default('') }}">
                            {% include 'components/_button.html.twig' with {
                                label: 'Absent',
                                variant: 'danger',
                                size: 'compact',
                                type: 'submit',
                                aria_label: 'Marquer le client absent'
                            } only %}
                        </form>

                        {% include 'components/_button.html.twig' with {
                            label: item.type == constant('App\\Entity\\AppointmentNotification::TYPE_APPOINTMENT_OVERDUE') ? 'Mettre à jour le statut' : 'Ouvrir le rendez-vous',
                            variant: item.type == constant('App\\Entity\\AppointmentNotification::TYPE_APPOINTMENT_OVERDUE') ? 'primary' : 'secondary',
                            size: 'compact',
                            type: 'button',
                            modal_target: item.modal_id
                        } only %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
