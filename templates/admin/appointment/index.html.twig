{% extends 'base.html.twig' %}

{% block title %}Rendez-vous admin - Mobile Clinic{% endblock %}
{% block meta_description %}Gestion administrateur des rendez-vous Mobile Clinic.{% endblock %}

{% block body %}
    <main class="dashboard-page dashboard-page--admin">
        <section class="dashboard-shell" aria-labelledby="admin-appointment-title">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-kicker">Administration</p>
                    <h1 id="admin-appointment-title">Gestion des rendez-vous</h1>
                    <p>Gérez les statuts clients et les rappels administratifs.</p>
                </div>

                {% include 'components/_dashboard_navigation.html.twig' with {
                    id: 'admin-appointment-menu',
                    kicker: 'Administration',
                    title: 'Menu rendez-vous',
                    subtitle: 'Sous-menus de la rubrique rendez-vous.',
                    items: [
                        {
                            label: 'Réglages rendez-vous',
                            href: path('app_admin_settings_index') ~ '#appointment-settings-title',
                            variant: 'primary',
                            icon: 'tool',
                            description: 'Rappels et délai client absent.'
                        },
                        {
                            label: 'Jours et plages',
                            href: path('app_admin_settings_index') ~ '#availability-title',
                            variant: 'secondary',
                            icon: 'calendar',
                            description: 'Gérer les créneaux visibles.'
                        },
                        {
                            label: 'Dashboard',
                            href: path('app_admin_dashboard'),
                            variant: 'secondary',
                            icon: 'home',
                            description: 'Retour à la vue générale.'
                        },
                        {
                            label: 'Déconnexion',
                            href: path('app_logout'),
                            variant: 'secondary',
                            icon: 'logout',
                            description: 'Quitter la session admin.'
                        }
                    ]
                } only %}
            </header>

            {% include 'components/_flash_messages.html.twig' %}
            <div class="ajax-toast" data-ajax-toast hidden></div>

            <div data-admin-notifications data-notifications-url="{{ path('app_api_admin_appointment_reminders', { q: search, status: status }) }}" data-notifications-interval="10000" data-notification-toast-keys="{{ reminder_view.toast_keys|json_encode|e('html_attr') }}">
                {% include 'admin/appointment/partial/_notification_center.html.twig' with {
                    reminder_view: reminder_view,
                    status: status,
                    search: search
                } only %}
            </div>

            {% include 'admin/appointment/partial/_stats.html.twig' with {
                stats: stats
            } only %}

            {% embed 'components/_data_table_shell.html.twig' with {
                id: 'appointment-list-title',
                kicker: 'Clients',
                title: 'Rendez-vous clients',
                subtitle: 'Recherche instantanée, statut et action admin sur une seule table.',
                count_label: appointments|length ~ ' ligne' ~ (appointments|length > 1 ? 's' : ''),
                icon: 'calendar'
            } %}
                {% block table_actions %}
                    <form class="filter-form filter-form--wide filter-form--instant data-table-filter" method="get" action="{{ path('app_admin_appointment_index') }}" data-instant-filter>
                        <label for="appointment-search">Recherche</label>
                        <input id="appointment-search" type="search" name="q" value="{{ search }}" placeholder="Client, téléphone, appareil ou problème" autocomplete="off">
                        <label for="status-filter">Statut</label>
                        <select id="status-filter" name="status">
                            <option value="">Tous les statuts</option>
                            {% for value, label in status_labels %}
                                <option value="{{ value }}" {% if status == value %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </form>
                {% endblock %}

                {% block table_content %}
                    {% include 'admin/appointment/partial/_table.html.twig' with {
                        appointments: appointments,
                        status_labels: status_labels,
                        admin_status_choices: admin_status_choices,
                        status: status,
                        search: search
                    } only %}
                {% endblock %}
            {% endembed %}

            {% include 'admin/appointment/partial/_modal_stack.html.twig' with {
                appointments: appointments,
                admin_status_choices: admin_status_choices,
                status_consequences: status_consequences,
                status: status,
                search: search
            } only %}
        </section>
    </main>
{% endblock %}
